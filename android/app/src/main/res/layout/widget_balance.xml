<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:gravity="center_horizontal">

    <!-- 顶部：标题 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DeepSeek Monitor"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 等待数据"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 刷新按钮 -->
        <LinearLayout
            android:id="@+id/widget_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/widget_refresh_btn_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 余额数值 -->
    <TextView
        android:id="@+id/widget_balance_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¥ --.--"
        android:textColor="#4D6BFE"
        android:textSize="26sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="剩余余额"
        android:textColor="#475569"
        android:textSize="8sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 今日 + 本月费用 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/widget_stat_bg">

            <TextView
                android:id="@+id/widget_today_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日 --"
                android:textColor="#A855F7"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日消耗"
                android:textColor="#475569"
                android:textSize="7sp"
                android:fontFamily="monospace"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@drawable/widget_stat_bg">

            <TextView
                android:id="@+id/widget_month_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月 --"
                android:textColor="#A855F7"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月消耗"
                android:textColor="#475569"
                android:textSize="7sp"
                android:fontFamily="monospace"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Token 用量 -->
    <TextView
        android:id="@+id/widget_flash_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待同步..."
        android:textColor="#64748B"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_pro_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开 App 获取数据"
        android:textColor="#64748B"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <!-- 更新时间 -->
    <TextView
        android:id="@+id/widget_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未同步"
        android:textColor="#334155"
        android:textSize="7sp"
        android:fontFamily="monospace"
        android:gravity="end" />

</LinearLayout>