<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DeepSeek"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="等待数据"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/widget_balance_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¥ --.--"
        android:textColor="#60A5FA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_today_cost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日 --"
        android:textColor="#C084FC"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/widget_month_cost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="本月 --"
        android:textColor="#C084FC"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/widget_flash_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flash: 等待同步"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/widget_pro_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pro: 等待同步"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/widget_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未同步"
        android:textColor="#64748B"
        android:textSize="8sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_refresh_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击刷新"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:gravity="center"
        android:layout_gravity="center"
        android:padding="6dp"
        android:layout_marginTop="4dp" />

</LinearLayout>