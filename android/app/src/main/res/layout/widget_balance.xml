<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DeepSeek Monitor"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等待数据"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- 刷新按钮 -->
        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="↻"
            android:textColor="#E2E8F0"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/widget_refresh_btn_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 余额 -->
    <TextView
        android:id="@+id/widget_balance_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¥ --.--"
        android:textColor="#60A5FA"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="剩余余额"
        android:textColor="#64748B"
        android:textSize="9sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 今日 / 本月费用 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/widget_stat_bg"
            android:layout_marginRight="4dp">

            <TextView
                android:id="@+id/widget_today_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日 --"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日消耗"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/widget_stat_bg"
            android:layout_marginLeft="4dp">

            <TextView
                android:id="@+id/widget_month_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月 --"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月消耗"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Token 用量 -->
    <TextView
        android:id="@+id/widget_flash_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待同步..."
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_pro_tokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开 App 获取数据"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginBottom="6dp" />

    <!-- 更新时间 -->
    <TextView
        android:id="@+id/widget_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未同步"
        android:textColor="#475569"
        android:textSize="8sp"
        android:gravity="end" />

</LinearLayout>