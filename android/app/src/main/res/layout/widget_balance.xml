<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 标题行：状态 + 刷新按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DeepSeek"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="等待数据"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="↻"
            android:textColor="#CBD5E1"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/widget_refresh_btn_bg" />
    </LinearLayout>

    <!-- 余额数值 -->
    <TextView
        android:id="@+id/widget_balance_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¥ --.--"
        android:textColor="#60A5FA"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="剩余余额"
        android:textColor="#64748B"
        android:textSize="9sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- 今日 / 本月费用 双栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/widget_stat_bg"
            android:layout_marginRight="5dp">

            <TextView
                android:id="@+id/widget_today_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日 --"
                android:textColor="#C084FC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日消耗"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/widget_stat_bg"
            android:layout_marginLeft="5dp">

            <TextView
                android:id="@+id/widget_month_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月 --"
                android:textColor="#C084FC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月消耗"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="8dp" />

    <!-- Token 用量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flash"
            android:textColor="#60A5FA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/widget_flash_tokens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="等待同步"
            android:textColor="#CBD5E1"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pro"
            android:textColor="#A855F7"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/widget_pro_tokens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="等待同步"
            android:textColor="#CBD5E1"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 更新时间 -->
    <TextView
        android:id="@+id/widget_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未同步"
        android:textColor="#475569"
        android:textSize="8sp"
        android:gravity="end" />

</LinearLayout>